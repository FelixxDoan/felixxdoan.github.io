---
import AboutHeroImage from "../../assets/avatar.jpg";
import Layout from "../../layouts/BlogPost.astro";
import { isLang, languages } from "../../i18n/ui";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isLang(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}

const aboutContent = {
  en: {
    title: "About Me",
    description:
      "Computer Networking graduate exploring backend systems, observability, and long-term growth toward DevOps and cloud infrastructure.",

    pathTitle: "My Path",
    pathBody1:
      "I started from computer networking, where I learned how systems communicate through TCP/IP, DNS, routing, and real network behavior.",
    pathBody2:
      "Over time, I became more interested in what happens on top of that foundation: how backend services receive requests, communicate with each other, manage data, and behave under real operational constraints.",

    whyTitle: "Why Backend Appeals to Me",
    whyBody:
      "What draws me to backend engineering is the combination of logic and systems thinking. I enjoy working on service boundaries, request flow, routing, storage, authentication, and the trade-offs between simplicity, scalability, and operational clarity.",

    buildTitle: "How I Learn and Build",
    buildBody:
      "I learn best by building real projects and writing about them. Instead of stopping at 'it works', I try to understand why a design makes sense, what its limitations are, and how infrastructure decisions affect application behavior. That is why many of my projects and technical notes focus on containerized systems, gateways, observability, and runtime concerns.",

    learningTitle: "What I'm Exploring Now",
    learningItems: [
      "Backend engineering through hands-on service design and container-based workflows",
      "Observability topics such as request correlation, structured logging, metrics, and failure handling",
      "CI/CD and deployment fundamentals to better connect development with operations",
      "Cloud infrastructure as a long-term direction built on top of backend and systems knowledge",
    ],

    directionTitle: "Where I’m Heading",
    directionBody:
      "My current goal is to grow into a strong backend engineer first, then expand deeper into DevOps and cloud through practical infrastructure, deployment, and operational work.",
  },

  vi: {
    title: "Về mình",
    description:
      "Cử nhân Mạng máy tính đang theo đuổi backend systems, observability và định hướng dài hạn sang DevOps cùng cloud infrastructure.",

    pathTitle: "Hành trình của mình",
    pathBody1:
      "Mình bắt đầu từ nền tảng computer networking, nơi mình học về TCP/IP, DNS, routing và cách các hệ thống giao tiếp trong môi trường thực tế.",
    pathBody2:
      "Sau đó, mình dần hứng thú hơn với những gì diễn ra phía trên lớp hạ tầng đó: backend service nhận request như thế nào, giao tiếp với nhau ra sao, quản lý dữ liệu thế nào và phản ứng thế nào trước các ràng buộc khi vận hành.",

    whyTitle: "Vì sao mình chọn Backend",
    whyBody:
      "Điều khiến mình thích backend engineering là sự kết hợp giữa logic và systems thinking. Mình thích làm việc với service boundaries, request flow, routing, storage, authentication và những trade-off giữa sự đơn giản, khả năng mở rộng và độ rõ ràng khi vận hành.",

    buildTitle: "Cách mình học và xây dựng",
    buildBody:
      "Mình học tốt nhất bằng cách tự build project thật và viết lại những gì đã làm. Mình không muốn dừng ở mức 'chạy được', mà muốn hiểu vì sao một thiết kế hợp lý, giới hạn của nó là gì, và các quyết định về hạ tầng ảnh hưởng thế nào đến hành vi của ứng dụng. Vì vậy, nhiều project và technical note của mình tập trung vào containerized systems, gateways, observability và các runtime concern.",

    learningTitle: "Hiện tại mình đang tìm hiểu",
    learningItems: [
      "Backend engineering thông qua thiết kế service và container-based workflows",
      "Observability như request correlation, structured logging, metrics và failure handling",
      "CI/CD và deployment fundamentals để nối development với operations tốt hơn",
      "Cloud infrastructure như một hướng phát triển dài hạn dựa trên nền backend và systems",
    ],

    directionTitle: "Hướng đi tiếp theo",
    directionBody:
      "Mục tiêu hiện tại của mình là trở thành một backend engineer vững hơn trước, rồi sau đó mở rộng sâu sang DevOps và cloud thông qua những công việc thực tế về hạ tầng, deployment và vận hành.",
  },
} as const;

const content = aboutContent[lang];
---

<Layout
  title={content.title}
  description={content.description}
  pubDate={new Date("March 23 2026")}
  lang={lang}
  tags={[]}
>
  <style is:global>
    /* Bỏ phần thời gian trong about */
    .prose .title .date {
      display: none;
    }
    /* Phá vỡ layout mặc định: Ẩn sidebar và cho phép nội dung mở rộng tối đa */
    .post-container {
      grid-template-columns: 1fr !important;
      max-width: 1000px !important;
    }
    .left-sidebar,
    .right-sidebar {
      display: none !important;
    }
    .prose {
      max-width: 100% !important;
      padding: 0 !important;
    }
  </style>
  <style>
    .about-container {
      display: flex;
      flex-direction: column;
      gap: 4rem; /* Tăng khoảng cách để tách hình và nội dung ra xa nhau hơn */
    }
    @media (min-width: 768px) {
      .about-container {
        flex-direction: row;
        align-items: flex-start;
      }
      .about-image {
        flex: 0 0 380px; /* Hình to hơn một xíu và nằm hẳn bên trái */
        position: sticky;
        top: 6rem;
      }
      .about-content {
        flex: 1 1 0%;
        /* Tăng thêm padding bên trái hoặc dựa vào gap để đẩy nội dung sang phải */
      }
    }
    .about-image img {
      width: 100%;
      height: auto;
      border-radius: 12px;
      box-shadow: var(--box-shadow);
      display: block;
    }
  </style>

  <div class="about-container">
    <div class="about-image">
      <Image src={AboutHeroImage} alt="Felix Doan" width={400} />
    </div>
    <div class="about-content">
      <p><strong>{content.pathTitle}</strong></p>
      <p>{content.pathBody1}</p>
      <p>{content.pathBody2}</p>

      <p><strong>{content.whyTitle}</strong></p>
      <p>{content.whyBody}</p>

      <p><strong>{content.buildTitle}</strong></p>
      <p>{content.buildBody}</p>

      <p><strong>{content.learningTitle}</strong></p>
      <ul>
        {content.learningItems.map((item) => <li>{item}</li>)}
      </ul>

      <p><strong>{content.directionTitle}</strong></p>
      <p>{content.directionBody}</p>
    </div>
  </div>
</Layout>
